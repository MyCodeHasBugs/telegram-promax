<Window x:Class="E2EChatClient.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E2E Encrypted Chat V2 — 32759"
        Height="640" Width="920"
        Background="#1e1e2e"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部连接面板 ===== -->
        <Border Grid.Row="0" Background="#181825" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="服务器:"    Foreground="#cdd6f4" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox   Grid.Column="1" x:Name="HostBox"   Text="127.0.0.1"   VerticalAlignment="Center" Background="#313244" Foreground="#cdd6f4" Padding="4"/>
                <TextBlock Grid.Column="2" Text="端口:"       Foreground="#cdd6f4" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <TextBox   Grid.Column="3" x:Name="PortBox"   Text="32759"          VerticalAlignment="Center" Background="#313244" Foreground="#cdd6f4" Padding="4"/>
                <TextBlock Grid.Column="4" Text="昵称:"       Foreground="#cdd6f4" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <TextBox   Grid.Column="5" x:Name="NameBox"    Text="alice"           VerticalAlignment="Center" Background="#313244" Foreground="#cdd6f4" Padding="4"/>
                <TextBlock Grid.Column="6" Text="房间:"       Foreground="#cdd6f4" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <TextBox   Grid.Column="7" x:Name="RoomBox"    Text="lobby"          VerticalAlignment="Center" Background="#313244" Foreground="#cdd6f4" Padding="4"/>
                <CheckBox  Grid.Column="8" x:Name="TlsBox"      Content="TLS"         VerticalAlignment="Center" Foreground="#cdd6f4" Margin="10,0,5,0" ToolTip="wss:// 加密. 必须同时填服务器证书 SHA256 指纹, 否则拒接"/>
                <TextBlock Grid.Column="9" Text="指纹:"          Margin="2,0,4,0" VerticalAlignment="Center" Foreground="#eba3ac" ToolTip="服务器证书 DER 的 SHA256 (43 长度, 由服务器 gen_self_signed_cert.py 打印出)"/>
                <TextBox   Grid.Column="10" x:Name="CertShaBox" Width="200"  VerticalAlignment="Center" Background="#313244" Foreground="#cdd6f4" Padding="4" ToolTip="留空 = 不连 (强制严格模式)"/>
                <TextBlock Grid.Column="11" x:Name="ConnStatus" Text="● 未连接" Foreground="#f38ba8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button    Grid.Column="10" x:Name="ConnBtn" Content="连接" Width="80" Height="28" Background="#89b4fa" Foreground="Black" Click="ConnBtn_Click"/>
            </Grid>
        </Border>

        <!-- F3-4 房间准入: 创建带密码房间 + 列出在线房间 -->
        <Border Grid.Row="1" Background="#11111b" Padding="8,4" Margin="0,1,0,0" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="新房:"    Foreground="#a6adc8" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox   x:Name="NewRoomBox"     Width="80" VerticalAlignment="Center" Background="#313244" Foreground="#cdd6f4" Padding="3" ToolTip="新房间名 (lobby 保留, 不可占用)"/>
                <TextBlock Text="密码:"    Foreground="#a6adc8" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <TextBox   x:Name="NewRoomPwBox"    Width="80" VerticalAlignment="Center" Background="#313244" Foreground="#cdd6f4" Padding="3" ToolTip="留空 = 公开房; 非空 ≥ 4 字符"/>
                <Button   Content="创建"    Width="60" Margin="6,0,12,0" Background="#a6e3a1" Foreground="Black" Click="CreateRoomBtn_Click" ToolTip="创建并加入 (调用者成 owner)"/>
                <Button   Content="刷新房间" Width="80" Margin="0,0,8,0" Background="#89b4fa" Foreground="Black" Click="RefreshRoomBtn_Click" ToolTip="向服务器查询当前所有在线房间"/>
            </StackPanel>
        </Border>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- 聊天记录 -->
            <DockPanel Grid.Column="0" LastChildFill="False">
                <Border DockPanel.Dock="Top" Background="#313244" Padding="8" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="聊天记录 (端对端加密)" FontWeight="Bold" Foreground="#cdd6f4"/>
                        <TextBlock x:Name="MyKeyBlock" Foreground="#a6adc8" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Top" Margin="0,4" Grid.Row="1" Background="#181825" CornerRadius="4" MinHeight="380">
                    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ChatPanel" Margin="8"/>
                    </ScrollViewer>
                </Border>
                <Grid DockPanel.Dock="Top" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="MsgBox" Background="#313244" Foreground="#cdd6f4" Padding="6" KeyDown="MsgBox_KeyDown"/>
                    <Button Grid.Column="1" x:Name="SendBtn" Content="发送 →" Margin="8,0,0,0" Background="#a6e3a1" Foreground="Black" Click="SendBtn_Click" IsEnabled="False"/>
                </Grid>
            </DockPanel>

            <!-- 右侧成员 + 系统 -->
            <Border Grid.Column="1" Background="#181825" CornerRadius="4" Margin="10,0,0,0" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="在线成员 (公钥指纹)" Foreground="#cdd6f4" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ListBox   Grid.Row="1" x:Name="MembersList" Background="#313244" Foreground="#cdd6f4"/>
                    <TextBlock Grid.Row="2" Text="安全事件" Foreground="#cdd6f4" FontWeight="Bold" Margin="0,6,0,4"/>
                    <ListBox   Grid.Row="3" x:Name="EventsList" Background="#313244" Foreground="#a6adc8"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 状态栏 ===== -->
        <Border Grid.Row="3" Background="#181825" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusBar" Foreground="#a6e3a1" Text="就绪" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
