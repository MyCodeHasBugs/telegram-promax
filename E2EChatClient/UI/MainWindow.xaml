<Window x:Class="E2EChatClient.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:E2EChatClient.UI"
        Title="E2E Encrypted Chat V2 — PQ"
        Height="720" Width="980"
        MinHeight="560" MinWidth="860"
        Background="#F20B0F1A"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- ===== 液态玻璃共享画刷 ===== -->
        <SolidColorBrush x:Key="GlassCard"    Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="GlassCard2"   Color="#28FFFFFF"/>
        <SolidColorBrush x:Key="GlassEdge"    Color="#59FFFFFF"/>
        <SolidColorBrush x:Key="GlassInputBg" Color="#38000000"/>
        <SolidColorBrush x:Key="TxtMain"      Color="#F2F6FF"/>
        <SolidColorBrush x:Key="TxtSoft"      Color="#BFCCD8"/>
        <SolidColorBrush x:Key="Accent"       Color="#8AB4FF"/>
        <SolidColorBrush x:Key="AccentSoft"   Color="#4D8AB4FF"/>
        <SolidColorBrush x:Key="Good"         Color="#8FE6A8"/>
        <SolidColorBrush x:Key="Bad"          Color="#FF9AA2"/>

        <!-- ===== 文本/颜色 ===== -->
        <Style x:Key="BaseText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TxtMain}"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== 玻璃文本输入框 ===== -->
        <Style x:Key="GlassTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource GlassInputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TxtMain}"/>
            <Setter Property="CaretBrush"  Value="{StaticResource TxtMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 液态玻璃按钮 ===== -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FF0B0F1A"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0"
                                BorderBrush="Transparent">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0.55*"/>
                                    <RowDefinition Height="0.45*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="Hi" Grid.RowSpan="2" CornerRadius="10" Background="#00000000"/>
                                <!-- 顶部高光 = 玻璃质感 -->
                                <Border x:Name="Sheen" Grid.Row="0" CornerRadius="10"
                                        VerticalAlignment="Stretch" Opacity="0.18"
                                        Background="White"/>
                                <ContentPresenter Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hi" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hi" Property="Background" Value="#11000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 纤细圆角滚动条 ===== -->
        <Style x:Key="GlassScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   IsEnabled="{TemplateBinding Orientation}"
                                   HorizontalAlignment="Stretch">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Th" CornerRadius="4"
                                                        Background="#4DFFFFFF" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 列表 = 玻璃卡内的透明容器 ===== -->
        <Style x:Key="GlassListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#14000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TxtMain}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- OpenGL 动态液态玻璃背景 (最底层, 不吃鼠标; GL 失败自动切 CPU 动画兜底) -->
        <ui:LiquidGlassBackground x:Name="GlassBg" Grid.RowSpan="4" IsHitTestVisible="False"/>
        <ui:AnimatedGlassFallback x:Name="GlassFallback" Grid.RowSpan="4" IsHitTestVisible="False"
                                  Visibility="Collapsed"/>

        <!-- ===== 顶部连接面板 (玻璃卡) ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource GlassCard}"
                BorderBrush="{StaticResource GlassEdge}"
                BorderThickness="1" CornerRadius="14"
                Padding="12" Margin="12,12,12,6">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource BaseText}" Text="服务器"    Margin="0,0,6,0"/>
                <TextBox  x:Name="HostBox"  Text="127.0.0.1" Width="120" Style="{StaticResource GlassTextBox}"/>
                <TextBlock Style="{StaticResource BaseText}" Text="端口"      Margin="12,0,6,0"/>
                <TextBox   x:Name="PortBox" Text="32759"      Width="64"  Style="{StaticResource GlassTextBox}"/>
                <TextBlock Style="{StaticResource BaseText}" Text="昵称"      Margin="12,0,6,0"/>
                <TextBox   x:Name="NameBox" Text="alice"      Width="110" Style="{StaticResource GlassTextBox}"/>
                <TextBlock Style="{StaticResource BaseText}" Text="房间"      Margin="12,0,6,0"/>
                <TextBox   x:Name="RoomBox" Text="lobby"      Width="110" Style="{StaticResource GlassTextBox}"/>
                <Button    x:Name="ConnBtn" Content="连 接" Width="90" Height="30"
                          Background="{StaticResource Accent}" Style="{StaticResource GlassButton}"
                          Margin="12,0,0,0" Click="ConnBtn_Click"/>
            </WrapPanel>
        </Border>

        <!-- ===== 房间管理条 ===== -->
        <Border Grid.Row="1"
                Background="{StaticResource GlassCard}"
                BorderBrush="{StaticResource GlassEdge}"
                BorderThickness="1" CornerRadius="14"
                Padding="10,7" Margin="12,0,12,6">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource BaseText}" Text="新房" Foreground="{StaticResource TxtSoft}" Margin="0,0,6,0"/>
                <TextBox  x:Name="NewRoomBox" Width="110" Style="{StaticResource GlassTextBox}" ToolTip="新房间名 (lobby 保留, 不可占用)"/>
                <TextBlock Style="{StaticResource BaseText}" Text="密码" Foreground="{StaticResource TxtSoft}" Margin="12,0,6,0"/>
                <TextBox  x:Name="NewRoomPwBox" Width="110" Style="{StaticResource GlassTextBox}" ToolTip="留空 = 公开房; 非空 ≥ 4 字符"/>
                <Button   Content="创 建"  Width="72"  Margin="10,0,0,0"
                          Background="{StaticResource Good}"  Style="{StaticResource GlassButton}"
                          Click="CreateRoomBtn_Click" ToolTip="创建并加入 (调用者成 owner)"/>
                <Button   Content="刷新房间" Width="90" Margin="8,0,0,0"
                          Background="{StaticResource Accent}" Style="{StaticResource GlassButton}"
                          Click="RefreshRoomBtn_Click" ToolTip="向服务器查询当前所有在线房间"/>
                <TextBlock x:Name="ConnStatus" Style="{StaticResource BaseText}"
                          Text="● 未连接" Foreground="{StaticResource Bad}" Margin="14,0,0,0" FontSize="13"/>
            </WrapPanel>
        </Border>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="2" Margin="12,0,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 聊天区: **修复发送区域被遮挡**
                 根因: 旧布局 DockPanel LastChildFill=False + 聊天区 MinHeight=380,
                       固定高度按序堆叠, 输入框被顶出客户区.
                 新布局: 标题🠕Top, 发送条🠗Bottom, 聊天列表 LastChildFill 吃满中间.
            -->
            <DockPanel Grid.Column="0" LastChildFill="True">
                <!-- 标题卡 -->
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource GlassCard}"
                        BorderBrush="{StaticResource GlassEdge}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="聊天记录（端对端加密 · PQ 混合握手）"
                                   Style="{StaticResource BaseText}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="MyKeyBlock" Style="{StaticResource BaseText}"
                                   Foreground="{StaticResource TxtSoft}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- **发送输入条 — 永远在底部可见** -->
                <Border DockPanel.Dock="Bottom"
                        Background="{StaticResource GlassCard}"
                        BorderBrush="{StaticResource GlassEdge}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="MsgBox"
                                 Style="{StaticResource GlassTextBox}"
                                 VerticalContentAlignment="Center"
                                 Height="34"
                                 KeyDown="MsgBox_KeyDown"/>
                        <Button Grid.Column="1" x:Name="SendBtn" Content="发 送 ➤"
                                Margin="8,0,0,0" Height="34"
                                Background="{StaticResource Good}" Style="{StaticResource GlassButton}"
                                Click="SendBtn_Click" IsEnabled="False"/>
                    </Grid>
                </Border>

                <!-- 聊天容器 (吃满剩余) -->
                <Border Background="#18FFFFFF"
                        BorderBrush="{StaticResource GlassEdge}"
                        BorderThickness="1" CornerRadius="12"
                        Margin="0,8,0,8">
                    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto"
                                  Padding="8">
                        <StackPanel x:Name="ChatPanel"/>
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <!-- ===== 右侧成员 + 事件 玻璃卡 ===== -->
            <Border Grid.Column="1"
                    Background="{StaticResource GlassCard}"
                    BorderBrush="{StaticResource GlassEdge}"
                    BorderThickness="1" CornerRadius="14"
                    Margin="10,0,0,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource BaseText}"
                               Text="在线成员（公钥指纹）"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Grid.Row="1" BorderBrush="{StaticResource GlassEdge}"
                            BorderThickness="1" CornerRadius="10" Background="#14000000"
                            ClipToBounds="True">
                        <ListBox x:Name="MembersList" Style="{StaticResource GlassListBox}"
                                 Background="Transparent" BorderThickness="0"/>
                    </Border>
                    <Button   Grid.Row="2" x:Name="KickBtn" Content="踢出选中成员" Height="30" Margin="0,8,0,0"
                             Background="{StaticResource Bad}" Style="{StaticResource GlassButton}"
                             Click="KickBtn_Click" IsEnabled="False"
                             ToolTip="仅房主可用. 踢出后该成员 10 分钟内不可再加入本房."/>
                    <TextBlock Grid.Row="3" Style="{StaticResource BaseText}"
                              Text="安全事件"
                              FontWeight="SemiBold" Margin="0,10,0,6"/>
                    <Border Grid.Row="4" BorderBrush="{StaticResource GlassEdge}"
                            BorderThickness="1" CornerRadius="10" Background="#14000000"
                            ClipToBounds="True">
                        <ListBox x:Name="EventsList"
                                 Style="{StaticResource GlassListBox}"
                                 Foreground="{StaticResource TxtSoft}"
                                 Background="Transparent" BorderThickness="0"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 状态栏 ===== -->
        <Border Grid.Row="3"
                Background="{StaticResource GlassCard}"
                BorderBrush="{StaticResource GlassEdge}"
                BorderThickness="1" CornerRadius="10"
                Padding="10,5" Margin="12,0,12,12">
            <TextBlock x:Name="StatusBar" Style="{StaticResource BaseText}"
                       Foreground="{StaticResource Good}" Text="就绪"
                       FontSize="12"/>
        </Border>
    </Grid>
</Window>
